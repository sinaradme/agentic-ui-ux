{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability route request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "tasks"
  ],
  "properties": {
    "context": {
      "$ref": "context.schema.json"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "coverage"
        ],
        "properties": {
          "id": {
            "enum": [
              "art-direction",
              "brand-consistency",
              "ux-flow",
              "onboarding",
              "form-states",
              "page-layout",
              "layout-refinement",
              "dashboard-layout",
              "typography",
              "color",
              "tokens",
              "system-consistency",
              "component-primitives",
              "section-blocks",
              "native-components",
              "component-discovery",
              "micro-interactions",
              "choreography",
              "scroll-motion",
              "layout-transitions",
              "complex-web-runtime",
              "complex-native-runtime",
              "motion-review",
              "motion-performance",
              "gesture",
              "feedback",
              "navigation",
              "image-direction",
              "product-illustration",
              "decorative-effect",
              "iconography",
              "responsive-layout",
              "native-platform",
              "keyboard-rtl",
              "accessibility-audit",
              "page-performance",
              "browser-diagnostics",
              "visual-review",
              "browser-inspection",
              "device-inspection",
              "native-e2e",
              "functional-regression"
            ]
          },
          "coverage": {
            "enum": [
              "adequate",
              "gap",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 1000
          },
          "provider": {
            "type": "string",
            "description": "Confirmed existing catalog tool ID or project"
          },
          "advanced": {
            "type": "boolean"
          },
          "materialFit": {
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "core",
              "supporting"
            ],
            "description": "Core task capabilities are routed before supporting capabilities."
          },
          "runtimeInventory": {
            "enum": [
              "none",
              "present",
              "unknown"
            ],
            "description": "Required for a new advanced animation runtime; includes runtimes outside this catalog."
          }
        }
      }
    },
    "policy": {
      "enum": [
        "minimal",
        "no-new-tools"
      ]
    },
    "asOf": {
      "type": "string",
      "format": "date",
      "description": "Current UTC date for metadata freshness checks; omit only for reproducible snapshot routing."
    },
    "surfaceType": {
      "enum": [
        "marketing",
        "product",
        "native",
        "unknown"
      ],
      "description": "Specify marketing website vs functional product UI vs native target. Existing system still wins; a core dashboard capability infers product when omitted."
    },
    "designMode": {
      "enum": [
        "refine",
        "rebuild",
        "reference-match",
        "new"
      ],
      "description": "Redesign defaults to rebuild. Select refine only for bounded polishing, reference-match for exact requested references. Rebuild requires redesign goal."
    }
  }
}
